{
  "name": "flipkart-automate",
  "version": "1.0.0",
  "private": true,
  "description": "Flipkart cookie automation — place orders + fast API order reports",
  "scripts": {
    "start": "node open-mobile.js",
    "mobile": "node open-mobile.js",
    "accounts": "node run-accounts.js",
    "accounts:fast": "node run-accounts.js --concurrency=3",
    "browse": "node browse-orders.js",
    "orders": "node check-orders.js --api --concurrency=12",
    "orders:browser": "node check-orders.js --concurrency=4",
    "orders:retry": "node check-orders.js --api --retry-failed --concurrency=8",
    "orders:enrich": "node check-orders.js --api --enrich --concurrency=12",
    "orders:excel": "node check-orders.js --from-json"
  },
  "dependencies": {
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  }
}
