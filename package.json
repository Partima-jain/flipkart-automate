{
  "name": "flipkart-automate",
  "version": "1.0.0",
  "private": true,
  "description": "Open Flipkart mobile browser already logged in via saved cookies",
  "scripts": {
    "start": "node open-mobile.js",
    "mobile": "node open-mobile.js",
    "accounts": "node run-accounts.js",
    "accounts:fast": "node run-accounts.js --concurrency=3",
    "orders": "node check-orders.js",
    "orders:browse": "node check-orders.js --browse --batch=3",
    "orders:excel": "node check-orders.js --from-json",
    "pending": "node build-cookie-pending.js",
    "qr": "node qr-demo.js"
  },
  "dependencies": {
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  }
}
